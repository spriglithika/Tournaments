{
    "model":
        {
            "name": "neural_ising_energy",
            "backbone": "resnet18",
            "freeze_backbone": false,
            "learn_J": true,
            "unfreeze_last_n": 1,
            "gamma": 0.5,
            "normalize_energy": true
        },
    "forward_kwargs":
        {
            "max_iter": 10,
            "alpha": 0.2,
            "lambda_": 0.00001,
            "tol": 1e-4,
            "softplus_before_energy": -1,
            "consistency_loss_weight": 0.000001,
            "mean_field": false
        },
    "num_classes": 10,
    "dataset": "fmnist",
    "samples_per_class": 1000,
    "resize": 28,
    "label_noise": 0.3,
    "train":
        {
            "lr": 0.001,
            "num_epochs": 30,
            "batch_size": 32
        },
    "val":
        {
            "split": 0.2,
            "patience": 20,
            "mode": "max"
        },
    "save_dir": "./experiments/outputs/EnergySoftmaxAfterL0p0001/",
    "save_J_heatmap": true,
    "seed": 42
}