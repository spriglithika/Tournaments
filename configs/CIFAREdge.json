{
    "model":
        {
            "name": "bradley_terry_edge",
            "backbone": "resnet18",
            "freeze_backbone": false,
            "unfreeze_last_n": 1
        },
    "forward_kwargs":
        {
            "max_iter": 50,
            "alpha": 0.25,
            "tol": 1e-4
        },
    "num_classes": 10,
    "dataset": "cifar10",
    "samples_per_class": -1,
    "resize": 32,
    "train":
        {
            "lr": 0.001,
            "num_epochs": 60,
            "batch_size": 32
        },
    "val":
        {
            "split": 0.2,
            "patience": 20,
            "mode": "max"
        },
    "save_dir": "./experiments/outputs/EnergySoftmaxAfterL0p0001/",
    "seed": 42
}