{
    "model":
        {
            "name": "neural_ising_energy_declarative_J",
            "backbone": "resnet18",
            "freeze_backbone": false,
            "unfreeze_last_n": 1
        },
    "forward_kwargs":
        {
            "max_iter": 10,
            "alpha": 0.2,
            "tol": 1e-4
        },
    "num_classes": 10,
    "dataset": "cifar10",
    "samples_per_class": -1,
    "resize": 32,
    "imbalance": {"0":1.0,"1":1.0,"2":1.0,"3":0.6,"4":0.6,"5":0.6,"6":0.2,"7":0.2,"8":0.2,"9":0.1},
    "train":
        {
            "lr": 0.001,
            "num_epochs": 60,
            "batch_size": 32
        },
    "val":
        {
            "split": 0.2,
            "patience": 20,
            "mode": "max"
        },
    "save_dir": "./experiments/outputs/EnergySoftmaxAfterL0p0001/",
    "save_J_heatmap": true,
    "seed": 42
}