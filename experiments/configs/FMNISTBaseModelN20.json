{
    "model":
        {
            "name": "base",
            "backbone": "resnet18",
            "freeze_backbone": false,
            "unfreeze_last_n": 1
        },
    "forward_kwargs":{},
    "num_classes": 10,
    "dataset": "fmnist",
    "samples_per_class": -1,
    "resize": 28,
    "label_noise": 0.2,
    "train":
        {
            "lr": 0.001,
            "num_epochs": 60,
            "batch_size": 32
        },
    "val":
        {
            "split": 0.2,
            "patience": 20,
            "mode": "max"
        },
    "save_dir": "./experiments/outputs/BaseModel/",
    "seed": 42
}